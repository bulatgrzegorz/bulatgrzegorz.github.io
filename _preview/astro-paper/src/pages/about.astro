---
import { getCollection, getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import config from "@/config";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostUrl } from "@/utils/getPostPaths";
import {
  domains,
  education,
  facts,
  jobs,
  languages,
  projects,
  skillGroups,
  stack,
  stackVisible,
  strengths,
} from "@/data/resume";

const stackIcons = import.meta.glob<string>("/src/assets/stack/*.svg", {
  eager: true,
  query: "?url",
  import: "default",
});
const stackIcon = (name: string) => {
  const url = stackIcons[`/src/assets/stack/${name}.svg`];
  if (!url) throw new Error(`Missing stack icon: src/assets/stack/${name}.svg`);
  return url;
};

const about = await getEntry("pages", "about");

if (!about) {
  throw new Error(
    "Missing content entry: `about.md` or `about.mdx` in `src/content/pages/`"
  );
}

const { Content } = await render(about);
const posts = getSortedPosts(await getCollection("posts")).slice(0, 3);
const year = (date: Date) => date.getUTCFullYear();

const sections = [
  { id: "about", label: "About" },
  { id: "experience", label: "Experience" },
  { id: "projects", label: "Projects" },
  { id: "skills", label: "Skills" },
  { id: "writing", label: "Writing" },
];
---

<Layout
  title={`${about.data.title} | ${config.site.title}`}
  description={about.data.description}
  ogImage={about.data.ogImage}
  canonicalURL={about.data.canonicalURL}
>
  <Header />

  <main id="main-content" class="cv">
    <aside class="cv-side">
      <button
        type="button"
        class="cv-photo-btn"
        aria-label="Enlarge photo"
        aria-haspopup="dialog"
      >
        <img
          class="cv-photo"
          src="/assets/img/uploads/profile.jpg"
          width="96"
          height="96"
          alt="Grzegorz Bułat"
        />
      </button>
      <dialog class="cv-lightbox" aria-label="Photo of Grzegorz Bułat">
        <img
          src="/assets/img/uploads/profile.jpg"
          width="2115"
          height="2391"
          alt="Grzegorz Bułat"
        />
      </dialog>
      <h1 class="cv-name">Grzegorz Bułat</h1>
      <p class="cv-role">Senior C# .NET Developer</p>
      <p class="cv-tagline">
        I build fast, distributed back-end systems for finance — and tools that
        make developers’ lives easier.
      </p>

      <ul class="cv-facts">
        {
          facts.map(f => (
            <li>
              <strong>{f.value}</strong>
              <span>{f.label}</span>
            </li>
          ))
        }
      </ul>

      <div class="cv-docks" style={`--count: ${stack.length}`}>
        <ul class="cv-dock" aria-label="Main tech stack">
          {
            stack.map((s, i) => (
              <li
                class:list={[
                  "cv-dock-item",
                  { "cv-dock-extra": i >= stackVisible },
                ]}
                data-label={s.name}
              >
                <img
                  src={stackIcon(s.icon)}
                  width="32"
                  height="32"
                  alt={s.name}
                />
              </li>
            ))
          }
          {
            stack.length > stackVisible && (
              <li class="cv-dock-more">
                <button
                  type="button"
                  aria-label={`Show ${stack.length - stackVisible} more`}
                >
                  +{stack.length - stackVisible}
                </button>
              </li>
            )
          }
        </ul>
        <ul class="cv-dock" aria-label="Languages">
          {
            languages.map(l => (
              <li
                class="cv-dock-item cv-dock-lang"
                data-label={`${l.name} — ${l.level}`}
              >
                <img
                  src={stackIcon(l.flag)}
                  width="32"
                  height="32"
                  alt={`${l.name} — ${l.level}`}
                />
              </li>
            ))
          }
        </ul>
      </div>

      <nav class="cv-nav" aria-label="Page sections">
        {
          sections.map(s => (
            <a href={`#${s.id}`} data-section={s.id}>
              <span class="cv-nav-line" />
              {s.label}
            </a>
          ))
        }
      </nav>

      <div class="cv-socials"><Socials /></div>
    </aside>

    <div class="cv-content">
      <section id="about" class="cv-section" aria-label="About">
        <h2 class="cv-heading">About</h2>
        <div class="cv-prose"><Content /></div>
        <ul class="cv-chips cv-domains" aria-label="Domain knowledge">
          {domains.map(d => <li>{d}</li>)}
        </ul>
      </section>

      <section id="experience" class="cv-section" aria-label="Experience">
        <h2 class="cv-heading">Experience</h2>
        <ol class="cv-list">
          {
            jobs.map((job, i) => (
              <li class="cv-card">
                <details open={i === 0}>
                  <summary>
                    <span class="cv-period">{job.period}</span>
                    <span class="cv-main">
                      <span class="cv-title">
                        {job.logo && (
                          <img
                            class="cv-logo"
                            src={job.logo}
                            width="20"
                            height="20"
                            alt=""
                          />
                        )}
                        <span>
                          {job.role} ·{" "}
                          {job.url ? (
                            <a class="cv-org" href={job.url}>
                              {job.company}
                            </a>
                          ) : (
                            <span class="cv-org">{job.company}</span>
                          )}
                          <span class="cv-toggle" aria-hidden="true" />
                        </span>
                      </span>
                      <span class="cv-headline">{job.headline}</span>
                      {job.clients && (
                        <span class="cv-clients">
                          <span class="cv-clients-label">Worked on</span>
                          {job.clients.map(c => (
                            <a class="cv-client" href={c.url}>
                              <img src={c.logo} width="16" height="16" alt="" />
                              {c.name}
                            </a>
                          ))}
                        </span>
                      )}
                      <span class="cv-chips cv-tags">
                        {job.tags.map(t => (
                          <span>{t}</span>
                        ))}
                      </span>
                    </span>
                  </summary>
                  <div class="cv-details">
                    {job.details.map(group => (
                      <div class="cv-group">
                        {group.title && (
                          <p class="cv-group-title">
                            {group.url ? (
                              <a href={group.url}>{group.title} ↗</a>
                            ) : (
                              group.title
                            )}
                          </p>
                        )}
                        <ul>
                          {group.items.map(d => (
                            <li>{d}</li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </details>
              </li>
            ))
          }
        </ol>
        <h3 class="cv-heading cv-subheading">Education</h3>
        <div class="cv-edu">
          <span class="cv-period">{education.period}</span>
          <p class="cv-title">
            <img
              class="cv-logo"
              src={education.logo}
              width="20"
              height="20"
              alt=""
            />
            <span>
              {education.field} ·{" "}
              <span class="cv-org">{education.school}</span>
            </span>
          </p>
        </div>
      </section>

      <section id="projects" class="cv-section" aria-label="Projects">
        <h2 class="cv-heading">Projects</h2>
        <ul class="cv-projects">
          {
            projects.map(p => (
              <li class="cv-card cv-project">
                <details>
                  <summary>
                    <h3 class="cv-title">
                      <a href={p.repo}>
                        {p.name} <span aria-hidden="true">↗</span>
                      </a>
                      <span class="cv-toggle" aria-hidden="true" />
                    </h3>
                    <p class="cv-headline">{p.headline}</p>
                  </summary>
                  <p class="cv-details">{p.details}</p>
                </details>
                <div class="cv-project-foot">
                  <span class="cv-chips cv-tags">
                    {p.tags.map(t => (
                      <span>{t}</span>
                    ))}
                  </span>
                  {p.live && (
                    <a class="cv-link" href={p.live.url}>
                      {p.live.label} ↗
                    </a>
                  )}
                </div>
              </li>
            ))
          }
        </ul>
        <a class="cv-link cv-all" href="https://github.com/bulatgrzegorz"
          >More on GitHub →</a
        >
      </section>

      <section id="skills" class="cv-section" aria-label="Skills">
        <h2 class="cv-heading">Skills</h2>
        <ul class="cv-strengths">
          {
            strengths.map(s => (
              <li>
                <strong>{s.title}</strong>
                <span>{s.text}</span>
              </li>
            ))
          }
        </ul>
        <dl class="cv-skills">
          {
            skillGroups.map(g => (
              <div>
                <dt>{g.name}</dt>
                <dd class="cv-chips">
                  {g.items.map(item => (
                    <span>{item}</span>
                  ))}
                </dd>
              </div>
            ))
          }
          <div>
            <dt>Languages</dt>
            <dd class="cv-chips">
              {
                languages.map(l => (
                  <span>
                    {l.name} — {l.level}
                  </span>
                ))
              }
            </dd>
          </div>
        </dl>
      </section>

      <section id="writing" class="cv-section" aria-label="Writing">
        <h2 class="cv-heading">Latest writing</h2>
        <ul class="cv-posts">
          {
            posts.map(post => (
              <li>
                <a href={getPostUrl(post.id, post.filePath)}>
                  <span class="cv-period">{year(post.data.pubDatetime)}</span>
                  <span class="cv-post-title">{post.data.title}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <a class="cv-link cv-all" href="/posts/">All articles →</a>
      </section>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const links = document.querySelectorAll<HTMLAnchorElement>(
      ".cv-nav a[data-section]"
    );
    if (!links.length) return;
    const setActive = (id: string) =>
      links.forEach(l =>
        l.classList.toggle("active", l.dataset.section === id)
      );
    const observer = new IntersectionObserver(
      entries => {
        const visible = entries.find(e => e.isIntersecting);
        if (visible) setActive(visible.target.id);
      },
      { rootMargin: "-30% 0px -60% 0px" }
    );
    document
      .querySelectorAll(".cv-section")
      .forEach(section => observer.observe(section));
    document.addEventListener(
      "astro:before-swap",
      () => observer.disconnect(),
      {
        once: true,
      }
    );
  });

  // Experience and project cards: the summary toggles the details natively;
  // this extends that to the rest of the card (including the expanded
  // details), except links and text selection.
  document.addEventListener("astro:page-load", () => {
    document
      .querySelectorAll<HTMLElement>(".cv-list .cv-card, .cv-project")
      .forEach(card => {
        const details = card.querySelector("details");
        if (!details) return;
        card.addEventListener("click", event => {
          const target = event.target as Element;
          if (target.closest("a, summary")) return;
          if (getSelection()?.toString()) return;
          details.open = !details.open;
        });
      });
  });

  // Stack and language docks: icons near the pointer grow, like the macOS
  // Dock.
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLElement>(".cv-dock").forEach(setUpDock);
  });

  function setUpDock(dock: HTMLElement) {
    // Hover reveals the rest of the stack; the "+N" tile does it for touch
    // and keyboard, and keeps it open.
    dock
      .querySelector(".cv-dock-more button")
      ?.addEventListener("click", () => dock.classList.add("is-open"));
    if (
      !matchMedia("(hover: hover)").matches ||
      matchMedia("(prefers-reduced-motion: reduce)").matches
    )
      return;

    const items = [...dock.querySelectorAll<HTMLElement>(".cv-dock-item")];
    const maxScale = 1.7;
    let frame = 0;
    let pointerX = 0;

    // Scales come from the resting layout, not the live one, so the dock
    // doesn't feed back on itself. Growth left of the pointer is shifted
    // out to the left, which keeps the hovered icon under the cursor.
    const magnify = () => {
      frame = 0;
      const tile = dock.clientHeight;
      const step = tile + parseFloat(getComputedStyle(dock).columnGap);
      const x = pointerX - dock.getBoundingClientRect().left;
      let shift = 0;
      items.forEach((item, i) => {
        const left = i * step;
        const distance = Math.min(
          Math.abs(x - left - tile / 2) / (tile * 3),
          1
        );
        const scale = 1 + (maxScale - 1) * Math.cos((distance * Math.PI) / 2);
        const covered = Math.min(Math.max((x - left) / tile, 0), 1);
        shift += tile * (scale - 1) * covered;
        item.style.setProperty("--s", scale.toFixed(3));
      });
      // Shift the tiles, not the list: the list's box is the hover area,
      // and moving it would slide it out from under the pointer.
      dock.style.setProperty("--shift", `${-shift}px`);
    };

    dock.addEventListener("pointermove", event => {
      pointerX = event.clientX;
      frame ||= requestAnimationFrame(magnify);
    });
    dock.addEventListener("pointerleave", () => {
      cancelAnimationFrame(frame);
      frame = 0;
      items.forEach(item => item.style.removeProperty("--s"));
      dock.style.removeProperty("--shift");
    });
  }

  // Photo lightbox: the enlarged photo grows out of the round thumbnail.
  document.addEventListener("astro:page-load", () => {
    const trigger = document.querySelector<HTMLButtonElement>(".cv-photo-btn");
    const thumb = trigger?.querySelector("img");
    const dialog = document.querySelector<HTMLDialogElement>(".cv-lightbox");
    const image = dialog?.querySelector("img");
    if (!trigger || !thumb || !dialog || !image) return;

    const timing = { duration: 420, easing: "cubic-bezier(0.2, 0.8, 0.2, 1)" };
    const reducedMotion = () =>
      matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Keyframes mapping the full image onto the thumbnail's circle.
    const morph = (): Keyframe[] => {
      const from = thumb.getBoundingClientRect();
      const to = image.getBoundingClientRect();
      const side = Math.min(to.width, to.height);
      const scale = from.width / side;
      const dx = from.left + from.width / 2 - (to.left + to.width / 2);
      const dy = from.top + from.height / 2 - (to.top + to.height / 2);
      const insetY = (to.height - side) / 2;
      const insetX = (to.width - side) / 2;
      return [
        {
          transform: `translate(${dx}px, ${dy}px) scale(${scale})`,
          clipPath: `inset(${insetY}px ${insetX}px round ${side / 2}px)`,
        },
        { transform: "none", clipPath: "inset(0px 0px round 20px)" },
      ];
    };
    const backdrop: Keyframe[] = [
      { backgroundColor: "rgb(8 11 16 / 0)", backdropFilter: "blur(0px)" },
      { backgroundColor: "rgb(8 11 16 / 0.82)", backdropFilter: "blur(10px)" },
    ];

    let closing = false;
    const open = () => {
      dialog.showModal();
      if (reducedMotion()) return;
      thumb.style.visibility = "hidden";
      dialog.animate(backdrop, timing);
      image.animate(morph(), timing);
    };
    const close = async () => {
      if (closing || !dialog.open) return;
      closing = true;
      if (!reducedMotion()) {
        const reverse = {
          ...timing,
          duration: 340,
          direction: "reverse" as const,
        };
        dialog.animate(backdrop, reverse);
        await image.animate(morph(), reverse).finished;
      }
      dialog.close();
      thumb.style.visibility = "";
      closing = false;
    };

    trigger.addEventListener("click", open);
    dialog.addEventListener("click", close);
    dialog.addEventListener("cancel", event => {
      event.preventDefault();
      close();
    });
  });
</script>

<style>
  .cv {
    width: min(1120px, calc(100% - 64px));
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 64px;
  }

  /* Sticky identity column */
  .cv-side {
    position: sticky;
    top: 0;
    align-self: start;
    max-height: 100vh;
    display: flex;
    flex-direction: column;
    padding-block: 56px 40px;
  }
  .cv-photo-btn {
    width: fit-content;
    border-radius: 50%;
    cursor: zoom-in;
  }
  .cv-photo {
    transition: transform 220ms;
  }
  .cv-photo-btn:hover .cv-photo {
    transform: scale(1.05);
  }
  .cv-lightbox {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 16px;
    border: 0;
    display: none;
    place-items: center;
    background: rgb(8 11 16 / 0.82);
    backdrop-filter: blur(10px);
    cursor: zoom-out;
  }
  .cv-lightbox[open] {
    display: grid;
  }
  .cv-lightbox::backdrop {
    background: transparent;
  }
  .cv-lightbox img {
    width: auto;
    height: auto;
    max-width: min(100%, 560px);
    max-height: 86dvh;
    border-radius: 20px;
    will-change: transform, clip-path;
  }
  .cv-photo {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--border);
  }
  .cv-name {
    margin-top: 20px;
    font-size: clamp(36px, 4vw, 48px);
    font-weight: 700;
    letter-spacing: -1.5px;
    line-height: 1.1;
  }
  .cv-role {
    margin-top: 10px;
    font-size: 18px;
    font-weight: 550;
    color: var(--accent);
  }
  .cv-tagline {
    margin-top: 14px;
    max-width: 360px;
    color: var(--muted-foreground);
    line-height: 1.6;
  }
  .cv-facts {
    display: flex;
    gap: 28px;
    margin-top: 28px;
  }
  .cv-facts li {
    display: flex;
    flex-direction: column;
    max-width: 120px;
  }
  .cv-facts strong {
    font-size: 22px;
    font-weight: 650;
  }
  .cv-facts span {
    font-size: 12px;
    line-height: 1.4;
    color: var(--muted-foreground);
  }
  /* Stack dock: tiles grow upwards; --s is set per tile by the script. */
  .cv-side {
    container-type: inline-size;
  }
  .cv-dock {
    --gap: 6px;
    --tile: min(
      36px,
      (100cqi - (var(--count) - 1) * var(--gap)) / var(--count)
    );
    display: flex;
    align-items: flex-end;
    gap: var(--gap);
    width: fit-content;
    height: var(--tile);
  }
  .cv-docks {
    display: flex;
    flex-direction: column;
    /* Room for a magnified flag to grow without covering the stack row. */
    gap: 24px;
    margin-top: 36px;
  }
  .cv-dock li {
    position: relative;
    flex: none;
    --size: calc(var(--tile) * var(--s, 1));
    width: var(--size);
    height: var(--size);
    padding: calc(var(--size) * 0.16);
    border: 1px solid var(--border);
    border-radius: 24%;
    background: #fff;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.12);
    translate: var(--shift, 0);
    transition:
      translate 140ms ease-out,
      width 140ms ease-out,
      height 140ms ease-out,
      padding 140ms ease-out,
      margin 140ms ease-out,
      border-width 140ms ease-out,
      opacity 140ms;
  }
  .cv-dock img {
    width: 100%;
    height: 100%;
  }
  .cv-dock .cv-dock-more {
    display: grid;
    background: var(--surface);
  }
  .cv-dock-more button {
    font-size: 12px;
    font-weight: 650;
    color: var(--muted-foreground);
    cursor: pointer;
  }
  .cv-dock-more button:hover {
    color: var(--foreground);
  }
  /* Collapsed tiles: zero width, and the negative margin eats their gap. */
  .cv-dock:not(:hover, :focus-within, .is-open) .cv-dock-extra,
  .cv-dock:is(:hover, :focus-within, .is-open) .cv-dock-more {
    width: 0;
    margin-left: calc(-1 * var(--gap));
    padding-inline: 0;
    border-width: 0;
    opacity: 0;
    pointer-events: none;
  }
  /* Flags fill the whole tile (no overflow: hidden, it would clip the label). */
  .cv-dock .cv-dock-lang {
    padding: 0;
    border: 0;
    background: none;
    box-shadow: none;
  }
  /* Sticker peel: hover cuts the bottom-right corner off the flag, and
     ::before draws that corner folded back over it. */
  .cv-dock-lang img {
    border: 1px solid var(--border);
    border-radius: inherit;
    object-fit: cover;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 100% 100%, 0 100%);
    transition: clip-path 220ms ease-out;
  }
  .cv-dock-lang::before {
    content: "";
    position: absolute;
    /* The clipped img paints in the positioned layer; stay above it. */
    z-index: 1;
    right: 0;
    bottom: 0;
    width: 0;
    height: 0;
    border-top-left-radius: 30%;
    background: linear-gradient(
      to bottom right,
      #fff 0%,
      #e4e4e4 42%,
      #a8a8a8 50%
    );
    box-shadow: -1px -1px 3px rgb(0 0 0 / 0.25);
    clip-path: polygon(0 0, 100% 0, 0 100%);
    transition:
      width 220ms ease-out,
      height 220ms ease-out;
  }
  .cv-dock-lang:hover img {
    clip-path: polygon(0 0, 100% 0, 100% 60%, 60% 100%, 0 100%);
  }
  .cv-dock-lang:hover::before {
    width: 40%;
    height: 40%;
  }
  .cv-dock-item::after {
    content: attr(data-label);
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    translate: -50% -4px;
    padding: 3px 9px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 550;
    white-space: nowrap;
    color: var(--background);
    background: var(--foreground);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 140ms,
      translate 140ms;
  }
  /* Lift the hovered tile so its label covers the row below. */
  .cv-dock-item:hover {
    z-index: 1;
  }
  .cv-dock-item:hover::after {
    opacity: 1;
    translate: -50% 0;
  }

  .cv-nav {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 40px;
  }
  .cv-nav a {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-block: 8px;
    width: fit-content;
    font-size: 12px;
    font-weight: 650;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }
  .cv-nav-line {
    display: block;
    width: 32px;
    height: 1px;
    background: currentColor;
    transition: width 180ms;
  }
  .cv-nav a:hover,
  .cv-nav a.active {
    color: var(--foreground);
  }
