---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import { cloudinary, cloudinarySrcset } from "@/utils/cloudinary";

// sizes defaults to the .article-grid column width (design.css breakpoints).
type Props = {
  variant?: "h2" | "h3";
  sizes?: string;
} & CollectionEntry<"posts">;
const {
  variant: Heading = "h2",
  sizes = "(max-width: 640px) calc(100vw - 36px), (max-width: 960px) calc(50vw - 44px), 360px",
  id,
  data,
  filePath,
} = Astro.props;
const image = data.optimized_image || data.image;
const date = new Intl.DateTimeFormat("en", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
}).format(data.pubDatetime);
---

<li class="article-card">
  <a
    class="article-card-link"
    href={getPostUrl(id, filePath, Astro.currentLocale)}
  >
    <div class="article-card-image">
      {
        data.image && (
          <img
            src={cloudinary(image, 760)}
            srcset={cloudinarySrcset(image, [400, 760])}
            sizes={sizes}
            alt=""
            loading="lazy"
            decoding="async"
          />
        )
      }
    </div>
    <div class="article-card-body">
      <div class="card-meta">
        <time datetime={data.pubDatetime.toISOString()}>{date}</time><span
          >{data.tags.slice(0, 2).join(" · ")}</span
        >
      </div>
      <Heading transition:name={toTransitionName(id)}>{data.title}</Heading>
      <p>{data.description}</p>
      <span class="card-read"
        >Read article <span aria-hidden="true">↗</span></span
      >
    </div>
  </a>
</li>
