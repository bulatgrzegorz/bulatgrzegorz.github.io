---
import IconSearch from "@/assets/icons/IconSearch.svg";
import config from "@/config";
const currentPath = Astro.url.pathname;
---

<a id="skip-to-content" class="skip-link" href="#main-content"
  >Skip to content</a
>
<header class="site-header">
  <a class="site-brand" href="/" aria-label={`${config.site.title} — home`}>
    <span class="brand-mark" aria-hidden="true">gb.</span>
    <span class="brand-name">Grzegorz Bułat<span>Software developer</span></span
    >
  </a>
  <nav class="site-nav" aria-label="Main navigation">
    <a
      class:list={{ selected: currentPath.startsWith("/posts") }}
      href="/posts/">Writing</a
    >
    <a
      class="nav-about"
      class:list={{ selected: currentPath.startsWith("/about") }}
      href="/about/">About</a
    >
    <a
      class="icon-button"
      href="/search/"
      aria-label="Search articles"
      title="Search articles"><IconSearch /></a
    >
  </nav>
</header>
