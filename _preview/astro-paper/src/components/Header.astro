---
import IconSearch from "@/assets/icons/IconSearch.svg";
import config from "@/config";
import { getAssetPath } from "@/utils/withBase";
const currentPath = Astro.url.pathname;
const brandHref = currentPath === "/" ? "/about/" : "/";
---

<a id="skip-to-content" class="skip-link" href="#main-content"
  >Skip to content</a
>
<header class="site-header">
  <a
    class="site-brand"
    href={brandHref}
    aria-label={`${config.site.title} — ${brandHref === "/" ? "home" : "About me"}`}
  >
    <img
      class="brand-mark"
      src={getAssetPath("gb.svg")}
      width="44"
      height="44"
      alt=""
    />
    <span class="brand-name">Grzegorz Bułat<span>Software developer</span></span
    >
  </a>
  <nav class="site-nav" aria-label="Main navigation">
    <a
      class:list={{ selected: currentPath.startsWith("/posts") }}
      href="/posts/">Writing</a
    >
    <a
      class="nav-about"
      class:list={{ selected: currentPath.startsWith("/about") }}
      href="/about/">About</a
    >
    <a
      class="icon-button"
      href="/search/"
      aria-label="Search articles"
      title="Search articles"><IconSearch /></a
    >
  </nav>
</header>
